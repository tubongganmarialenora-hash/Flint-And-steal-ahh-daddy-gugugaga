--==================================================
-- HUB FADE IN
--==================================================

local function FadeIn(root)
	local objects = {root}

	for _, obj in ipairs(root:GetDescendants()) do
		table.insert(objects, obj)
	end

	local saved = {}

	for _, obj in ipairs(objects) do
		local props = {}

		if obj:IsA("Frame") or obj:IsA("ScrollingFrame")
		or obj:IsA("TextLabel") or obj:IsA("TextButton") then
			props.BackgroundTransparency = obj.BackgroundTransparency
			obj.BackgroundTransparency = 1
		end

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			props.TextTransparency = obj.TextTransparency
			obj.TextTransparency = 1
		end

		if obj:IsA("UIStroke") then
			props.Transparency = obj.Transparency
			obj.Transparency = 1
		end

		if next(props) then
			saved[obj] = props
		end
	end

	for obj, props in pairs(saved) do
		if obj.Parent or obj == root then
			Tween(obj, 0.65, props)
		end
	end
end

