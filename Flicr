--==================================================
-- HELPERS
--==================================================

local function Tween(obj, time, props)
	local animation = TweenService:Create(
		obj,
		TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		props
	)
	animation:Play()
	return animation
end

local function Round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
end

local function Outline(obj, color)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = 1
	s.Transparency = 0.3
	s.Parent = obj
end

local function AddGradient(obj)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Orange),
		ColorSequenceKeypoint.new(0.5, Gold),
		ColorSequenceKeypoint.new(1, Orange)
	})
	g.Parent = obj
	return g
end

local function MakeText(parent, text, size, position, textSize)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Text = text
	label.TextColor3 = White
	label.TextSize = textSize or 13
	label.Font = Enum.Font.Gotham
	label.Parent = parent
	return label
end

